# Environment Variables Example for GovPrep Backend
# For PostgreSQL (Production/Staging):
# DATABASE_URL="postgresql://username:password@localhost:5432/govprep_db?schema=public"
# For SQLite (Local Zero-Config Development):
DATABASE_URL="file:./dev.db"

JWT_SECRET="your_jwt_secret_key_change_in_production"

# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.0-flash"

# Legacy AI keys (for backwards compatibility)
AI_API_KEY=""
AI_MODEL="gemini-2.0-flash"

PORT=5000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# Syllabus Documents Configuration
SYLLABUS_DIR="./data/syllabus"

